#include <stdio.h>

int maior(int a, int b){
    return (a > b) ? a : b;
}

int menor( int a, int b){
    return (a < b) ? a : b;
}

float media(float a, float b){
    return (a + b) / 2.0;
}

int fatorial(int n){
    if (n < 0) return -1
    int fat = 1;
    for (int i = 1; i <= n; i++){
        fat *= i;
    }
    return fat;
}

int main(){
    int n1, n2, numFat;

    printf ("Digite os dois numeros inteiros:\n");
    scanf ("%d %d", &n1, &n2);

    printf ("\n---Resultados das Funcoes ---\n");
    printf ("Maior entre %d e %d> %d\n", n1, n2, maior(n1, n2));
    printf ("Menor entre %d e %d: %d\n", n1, n2, menor(n1, n2));
    printf ("Media entre %d e %d: %.2f\n", n1, n2, media((float))n1, (float)n2));

    if (numFat >= 0){
        printf ("Fatorial de %d: %d\n", numFat, fatorial(numFat));
    }   else{
        printf ("Nao e possivel calcular fatorial de numero negativo.\n");
    }

    return 0;
}
